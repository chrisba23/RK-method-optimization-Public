% Tested configurations:
% p = 4: s = 8:9
% for s = 9, 5 runs were performed and all returned unstable methods, which
% are stored in "unsuccessful_runs".
thisFile = matlab.desktop.editor.getActiveFilename;
baseDir = fileparts(thisFile);
cd(baseDir);

repoDir = fullfile(baseDir,'..','..','..','..','..','Extern-Repos','RK-Opt-add_2N_fixed');
addpath(genpath(repoDir),'-begin');
clear functions

%% Parameters

alpha = 1;
epsi  = 1e-3;

lam1 = -alpha;
lam2 = -1/epsi;

% Construct the spectrum.
kappa = 0.05;           
r1 = kappa*abs(lam1);
r2 = kappa*abs(lam2);

M = 300;                
theta = linspace(0, 2*pi, M);

D1 = lam1 + r1*cos(theta) + 1i*r1*sin(theta);
D2 = lam2 + r2*cos(theta) + 1i*r2*sin(theta);
S  = [D1, D2];

%% Optimization
p = 4;
s = 9;


% Optimize the stability with PolyOpt
[h_star, R_vals] = opt_poly_bisect(S, s, p, 'chebinterp');
fprintf('p=%d, s=%d:  h* = %.6g', p, s, h_star);

% Construct the Chebyshev interpolation nodes corresponding to the
% polynomial values returned by PolyOpt.
z      = h_star * S;
zmin   = min(real(z));
zmax   = 0;
N      = s;
j      = 0:N;
x_cheb = cos(pi*j/N);
z_nodes_full = 0.5*((zmax+zmin) + (zmax - zmin)*x_cheb);
z_nodes_full = z_nodes_full(:);   % (s+1) x 1
R_vals_full = R_vals(:);         

% Select K = s-p interpolation nodes on the full interpolation interval [zmin, 0].            
K = s-p; 
jK = (1:K)';
xK = cos(pi*jK/(K+1));

z_nodes = 0.5*((zmax+zmin) + (zmax-zmin)*xK);
z_nodes = sort(z_nodes);

R_vals_K = bary_eval_cheb(z_nodes_full, R_vals_full, z_nodes);



R_eval = bary_eval_cheb(z_nodes_full, R_vals_full, h_star*S);
mx = max(abs(R_eval));
fprintf(',   max |R(h*lambda)| = %.3e\n', mx);


% RK-optimization
rk = rk_opt(s, p, '3Sstar', 'acc', ...
    'interp_nodes',  z_nodes, ...
    'interp_values', R_vals_K, ...
    'algorithm','interior-point', ...
    'num_starting_points', 300, ...
    'write_to_file', 1, ...
    'append_time', 1, ...
    'suppress_warnings', true);


function p = bary_eval_cheb(z_nodes, f_nodes, z_eval)
z_nodes = z_nodes(:);
f_nodes = f_nodes(:);
z_eval  = z_eval(:);

N = length(z_nodes) - 1;

w = ones(N+1,1);
w(1)   = 0.5;
w(end) = 0.5;
w = w .* (-1).^(0:N)';

p = zeros(size(z_eval));

for k = 1:length(z_eval)
    zk = z_eval(k);

    idx = find(abs(zk - z_nodes) < 1e-14, 1);
    if ~isempty(idx)
        p(k) = f_nodes(idx);
    else
        temp = w ./ (zk - z_nodes);
        p(k) = sum(temp .* f_nodes) / sum(temp);
    end
end
end



% Check the RK stability function on the two eigenvalues and on the full spectrum.
 function check_two_scale_stability(rk, h, alpha, epsi, S)
    A = rk.A;
    b = rk.b(:);
    s = numel(b);
    e = ones(s,1);
    I = eye(s);

    lam1 = -alpha;
    lam2 = -1/epsi;

    z_lam = h * [lam1; lam2];
    z_S   = h * S(:);

    z_all = [z_lam; z_S];
    R_all = zeros(size(z_all));

    % Evaluate the stability function
    % R(z) = 1 + z b^T (I - zA)^{-1} e.
    for j = 1:numel(z_all)
        z = z_all(j);
        Y = (I - z*A)\e;          
        R_all(j) = 1 + z*(b.'*Y); 
    end

    R_lam = R_all(1:2);
    R_S   = R_all(3:end);

    fprintf('h = %.6g\n', h);
    fprintf('lambda1 = %g: R = %g (|R| = %.6f)\n', lam1, R_lam(1), abs(R_lam(1)));
    fprintf('lambda2 = %g: R = %g (|R| = %.6f)\n', lam2, R_lam(2), abs(R_lam(2)));
    fprintf('max |R_RK(h*lambda)| over S: %.6f\n', max(abs(R_S)));
end


dt = h_star;
check_two_scale_stability(rk, dt, alpha, epsi, S);



dataDir = fullfile(baseDir, 'polyopt_data');
if ~exist(dataDir, 'dir')
    mkdir(dataDir);
end

method_type = '3Sstar'; 
basis = 'chebinterp';

files = dir(fullfile(baseDir, sprintf('%s-%d-%d_*.txt', method_type, p, s)));

[~, idxNewest] = max([files.datenum]);
methodName = files(idxNewest).name;

[~, baseName, ~] = fileparts(methodName);
dataFile = fullfile(dataDir, [baseName '_plot_data.mat']);

experiment = struct();

experiment.method_file = methodName;
experiment.method_type = method_type;
experiment.basis = basis;

experiment.h_star = h_star;
experiment.M = M;
experiment.S = S(:);

experiment.z_nodes_full = z_nodes_full;
experiment.R_vals_full = R_vals_full;

save(dataFile, 'experiment');

fprintf('Saved plot data file:\n%s\n', dataFile);

