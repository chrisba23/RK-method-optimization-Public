thisFile = matlab.desktop.editor.getActiveFilename;
baseDir = fileparts(thisFile);
cd(baseDir);
addpath(genpath(fullfile(baseDir,'..','..','..','..','..','Extern-Repos','RK-Opt-add_2N_fixed')));

% Create the output folder for plots and data files
plotDir = fullfile(baseDir, 'plots');
if ~exist(plotDir, 'dir')
    mkdir(plotDir);
end

%% Optimization for the Two-scale test spectrum


% Define the slow and fast eigenvalues of the two-scale test problem
alpha = 1;
epsi  = 1e-3;

lam1 = -alpha;
lam2 = -1/epsi;

% Build two circular clusters around the slow and fast eigenvalues
kappa = 0.05;           
r1 = kappa*abs(lam1);
r2 = kappa*abs(lam2);

M = 300;                
theta = linspace(0, 2*pi, M);

D1 = lam1 + r1*cos(theta) + 1i*r1*sin(theta);
D2 = lam2 + r2*cos(theta) + 1i*r2*sin(theta);
S  = [D1, D2];

p = 4;
s = 7;

% Choose the order and the number of stages
[h_star, a] = opt_poly_bisect(S, s, p, 'chebyshev');

mx = max(abs(polyval(fliplr(a), h_star*S)));
fprintf('p=%d, s=%d:  h* = %.6g,   max |R(h*λ)| = %.3e\n', p, s, h_star, mx);


% Use RK-Opt with the polynomial obtained from PolyOpt
function rk = rk_from_poly(poly_coeff, p, s)
    m = s-p;              % Number of polynomial coefficients to fix
    poly_ind = (s-m+1):s;
    poly_val = poly_coeff(poly_ind + 1); % Corresponding coefficient values
    c_lower_bound = zeros(s, 1);
    c_upper_bound = ones(s, 1);

    rk = rk_opt(s, p, '2N', 'acc', ...
        'poly_coeff_ind', poly_ind, ... 
        'poly_coeff_val', poly_val, ...
        'c_lower_bound', c_lower_bound, ...
        'c_upper_bound', c_upper_bound, ...
        'algorithm', 'interior-point', ...
        'num_starting_points', 300, ...
        'write_to_file', 1, ...
        'suppress_warnings', true);

 end
 rk = rk_from_poly(a,p,s);

      % 'c_lower_bound', c_lower_bound, ...
      %  'c_upper_bound', c_upper_bound, ...
      % 'c_monotone', c_monotone, ...

      
%% Stability check
% Check the RK stability function on the two eigenvalues and on the full spectrum.
 function check_two_scale_stability(rk, h, alpha, epsi, S)
    A = rk.A;
    b = rk.b(:);
    s = numel(b);
    e = ones(s,1);
    I = eye(s);

    lam1 = -alpha;
    lam2 = -1/epsi;

    z_lam = h * [lam1; lam2];
    z_S   = h * S(:);

    z_all = [z_lam; z_S];
    R_all = zeros(size(z_all));

     % Stabilitifunction : R(z) = 1 + z * b^T * (I - zA)^{-1} * e
    for j = 1:numel(z_all)
        z = z_all(j);
        Y = (I - z*A)\e;          % (I - zA) * Y = e
        R_all(j) = 1 + z*(b.'*Y); 
    end

    R_lam = R_all(1:2);
    R_S   = R_all(3:end);

    fprintf('h = %.6g\n', h);
    fprintf('lambda1 = %g: R = %g (|R| = %.6f)\n', lam1, R_lam(1), abs(R_lam(1)));
    fprintf('lambda2 = %g: R = %g (|R| = %.6f)\n', lam2, R_lam(2), abs(R_lam(2)));
    fprintf('max |R_RK(h*lambda)| over S: %.6f\n', max(abs(R_S)));
end


dt = h_star;
check_two_scale_stability(rk, dt, alpha, epsi, S);

%% Save plot data 

dataDir = fullfile(baseDir, 'polyopt_data');
if ~exist(dataDir, 'dir')
    mkdir(dataDir);
end

method_type = '2N';
basis = 'chebyshev';

files = dir(fullfile(baseDir, sprintf('%s-%d-%d_*.txt', method_type, p, s)));


[~, idxNewest] = max([files.datenum]);
methodName = files(idxNewest).name;

[~, baseName, ~] = fileparts(methodName);
dataFile = fullfile(dataDir, [baseName '_plot_data.mat']);

experiment = struct();

experiment.method_file = methodName;
experiment.method_type = method_type;
experiment.basis = basis;

experiment.h_star = h_star;
experiment.M = M;
experiment.S = S(:);

experiment.a = a(:);

save(dataFile, 'experiment');

fprintf('Saved plot data file:\n%s\n', dataFile);


%% Plot near the slow and fast clusters
% Compare the RK stability region with the PolyOpt boundary near both clusters.

A = rk.A;
b = rk.b(:);

M = 300;
theta = linspace(0, 2*pi, M);

zSlow = h_star * (lam1 + r1*cos(theta) + 1i*r1*sin(theta));
zFast = h_star * (lam2 + r2*cos(theta) + 1i*r2*sin(theta));

clusters = {zSlow, zFast};
centers  = [h_star*lam1, h_star*lam2];

rads   = [4, 1.8*h_star*r2];
titles = {'Slow cluster', 'Fast cluster'};

figure;
t = tiledlayout(1,2,'Padding','compact','TileSpacing','compact');

ax = gobjects(1,2);

for j = 1:2
    z_spec = clusters{j};
    z0     = centers(j);
    rad    = rads(j);

    z_plot = z_spec(1:12:end);

    n = 600;
    x = linspace(real(z0)-rad, real(z0)+rad, n);
    y = linspace(imag(z0)-rad, imag(z0)+rad, n);
    [XX,YY] = meshgrid(x,y);
    Z = XX + 1i*YY;

    % Evaluate the RK method and the PolyOpt reference polynomial.
    R_rk   = R_by_butcher(A, b, Z);
    R_poly = polyval(flipud(a(:)), Z);

    ax(j) = nexttile;
    hold(ax(j), 'on');
    axis(ax(j), 'equal');
    grid(ax(j), 'on');

    contourf(ax(j), XX, YY, abs(R_rk)<=1, [1 1], 'LineStyle', 'none');
    contour(ax(j), XX, YY, abs(R_poly), [1 1], 'k', 'LineWidth', 2);

    plot(ax(j), real(z_plot), imag(z_plot), 'ro', ...
        'MarkerSize', 4, 'MarkerFaceColor', 'r');

    plot(ax(j), real(z0), imag(z0), 'bo', ...
        'MarkerSize', 6, 'MarkerFaceColor', 'b');

    xlim(ax(j), [real(z0)-rad, real(z0)+rad]);
    ylim(ax(j), [imag(z0)-rad, imag(z0)+rad]);

    xlabel(ax(j), 'Re(z)');
    ylabel(ax(j), 'Im(z)');
    title(ax(j), titles{j});
end

% Single legend for the whole tiled layout
hold(ax(2), 'on');
hFill = patch(ax(2), NaN, NaN, [0.75 0.9 0.9], 'EdgeColor', 'none');
hPoly = plot(ax(2), NaN, NaN, 'k', 'LineWidth', 2);
hSpec = plot(ax(2), NaN, NaN, 'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 4);
hCent = plot(ax(2), NaN, NaN, 'bo', 'MarkerFaceColor', 'b', 'MarkerSize', 6);

lgd = legend(ax(2), [hFill, hPoly, hSpec, hCent], ...
    {'RK stable region', 'PolyOpt boundary', 'Scaled spectrum', 'Center'});
lgd.Layout.Tile = 'east';

if ~exist(plotDir, 'dir')
    mkdir(plotDir);
end

% Save the plot
plotFile = fullfile(plotDir, sprintf('2N_p%d_s%d_chebyshev_plot.png', p, s));
drawnow;
frame = getframe(gcf);
imwrite(frame.cdata, plotFile);

% Save the PolyOpt coefficients
coeffFile = fullfile(plotDir, sprintf('2N_p%d_s%d_chebyshev_data.txt', p, s));
fid = fopen(coeffFile, 'w');
if fid == -1
    error('Could not open file: %s', coeffFile);
end

fprintf(fid, 'PolyOpt coefficients a\n');
fprintf(fid, '%.16g\n', real(a(:)));

fclose(fid);


%% Compare different stability function evaluations

% Compare the stability function from the 2N implementation, the Butcher form,
% and the polynomial coefficients.
A = rk.A;
b = rk.b(:);


A2N = rk.A_2N(:);
B2N = rk.B_2N(:);

rad = 1.5 * h_star * r2;
z0  = h_star * lam2;

M = 300;
theta = linspace(0, 2*pi, M);

D2 = lam2 + r2*cos(theta) + 1i*r2*sin(theta);
z_circle = h_star * D2(:);


spec_step = 12;
z_spec = z_circle(1:spec_step:end);

n = 700;
x = linspace(real(z0)-rad, real(z0)+rad, n);
y = linspace(imag(z0)-rad, imag(z0)+rad, n);
[XX,YY] = meshgrid(x,y);
Z = XX + 1i*YY;

% Evaluate the stability function in three different ways.
R_2N      = R_by_one_step_2N_vec(A2N, B2N, Z);
R_butcher = R_by_butcher(A, b, Z);
a_pow = stability_poly_coeffs_from_butcher(A, b);
R_pow = polyval(flipud(a_pow), Z);
% Evaluate the PolyOpt reference polynomial.
R_poly = polyval(flipud(a(:)), Z);

figure;
tiledlayout(1,3,'Padding','compact','TileSpacing','compact');

nexttile;
plot_stability_panel(XX, YY, R_2N, R_poly, z_spec, z0, rad, ...
    'Low-storage (2N)', false);

nexttile;
plot_stability_panel(XX, YY, R_butcher, R_poly, z_spec, z0, rad, ...
    'R(z)=1+zb^T(I-zA)^{-1}1', false);

nexttile;
plot_stability_panel(XX, YY, R_pow, R_poly, z_spec, z0, rad, ...
    'R(z)=1+\Sigma z^k b^T A^{k-1}1', true);

if ~exist(plotDir, 'dir')
    mkdir(plotDir);
end

plotFile = fullfile(plotDir, sprintf('2N_p%d_s%d_chebyshev_compare3.png', p, s));
drawnow;
frame = getframe(gcf);
imwrite(frame.cdata, plotFile);


function plot_stability_panel(XX, YY, R_panel, R_poly, z_spec, z0, rad, panelTitle, showLegend)
hold on; axis equal; grid on;

% RK stable region as filled surface
contourf(XX,YY, abs(R_panel)<=1, [1 1], 'LineStyle','none');

% PolyOpt as black line
contour(XX,YY, abs(R_poly), [1 1], 'k', 'LineWidth', 2);

% scaled spectrum as red points
hSpec = plot(real(z_spec), imag(z_spec), 'ro', ...
    'MarkerSize', 4, 'LineWidth', 1, 'MarkerFaceColor', 'r');

% mark the sacaled fast eigenvalues
hCenter = plot(real(z0), imag(z0), 'o', ...
    'MarkerSize', 6, ...
    'LineWidth', 1.2, ...
    'MarkerEdgeColor', [0 0.2 0.7], ...
    'MarkerFaceColor', [0 0.2 0.7]);

xlim([real(z0)-rad, real(z0)+rad]);
ylim([imag(z0)-rad, imag(z0)+rad]);
set(gca,'XLimMode','manual','YLimMode','manual');

xlabel('Re(z)');
ylabel('Im(z)');
title(panelTitle);

if showLegend
    hFill = patch(NaN,NaN,[0.15 0.75 0.75], 'EdgeColor','none');
    hPoly = plot(NaN,NaN,'k','LineWidth',2);

    lgd = legend([hFill,hPoly,hSpec,hCenter], ...
        {'RK region', 'PolyOpt', 'Spectrum', 'Fast eigenvalue'}, ...
        'Location','eastoutside');
    lgd.FontSize = 8;
end
end


function coeffs = stability_poly_coeffs_from_butcher(A, b)
b = b(:);
s = length(b);
e = ones(s,1);

coeffs = zeros(s+1,1);
coeffs(1) = 1;

v = e;
for j = 1:s
    coeffs(j+1) = b.' * v;
    v = A * v;
end
end


function R = R_by_one_step_2N_vec(A2N, B2N, Z)
A2N = A2N(:);
B2N = B2N(:);

S1 = ones(size(Z));
S2 = zeros(size(Z));

for i = 1:length(B2N)
    S2 = A2N(i).*S2 + Z.*S1;
    S1 = S1 + B2N(i).*S2;
end

R = S1;
end


function R = R_by_butcher(A, b, Z)
s = length(b);
e = ones(s,1);
I = eye(s);

R = zeros(size(Z));
for k = 1:numel(Z)
    z = Z(k);
    Y = (I - z*A) \ e;
    R(k) = 1 + z * (b.' * Y);
end
R = reshape(R, size(Z));
end



%% Pseudocolor plot of one stability function
% Plot the absolute value of one selected stability function near the fast cluster

A = rk.A;
b = rk.b(:);

A2N = rk.A_2N(:);
B2N = rk.B_2N(:);

rad = 1.5 * h_star * r2;
z0  = h_star * lam2;

theta = linspace(0,2*pi,300);
D2 = lam2 + r2*cos(theta) + 1i*r2*sin(theta);
z_circle = h_star * D2(:);
z_spec = z_circle(1:12:end);

x = linspace(real(z0)-rad, real(z0)+rad, 600);
y = linspace(imag(z0)-rad, imag(z0)+rad, 600);
[XX,YY] = meshgrid(x,y);
Z = XX + 1i*YY;

R_2N      = R_by_one_step_2N_vec(A2N, B2N, Z);
R_butcher = R_by_butcher(A, b, Z);
a_pow     = stability_poly_coeffs_from_butcher(A, b);
R_pow     = polyval(flipud(a_pow), Z);

% Select which representation should be plotted.
plotMode = '2N';

switch plotMode
    case 'powers'
        R_sel = R_pow;
        plotTitle = 'R(z)=1+\Sigma z^k b^T A^{k-1}1';
        fileTag = 'powers';

    case 'butcher'
        R_sel = R_butcher;
        plotTitle = 'R(z)=1+zb^T(I-zA)^{-1}1';
        fileTag = 'butcher';

    case '2N'
        R_sel = R_2N;
        plotTitle = 'Low-storage 2N';
        fileTag = '2N';
end

V = abs(R_sel);
Vplot = min(V,1.25);

figure;
hold on; axis equal; grid on;

levels = [0 0.25 0.5 0.75 1.0 1.25];
contourf(XX,YY,Vplot,levels,'LineStyle','none');

colormap([
    0.23 0.20 0.75
    0.28 0.53 0.88
    0.28 0.78 0.68
    0.95 0.90 0.20
    0.92 0.10 0.10
    ]);

caxis([0 1.25]);

cb = colorbar;
ylabel(cb,'|R(z)|');
cb.Ticks = [0 0.25 0.5 0.75 1 1.25];
cb.TickLabels = {'0','0.25','0.5','0.75','1','>1'};

contour(XX,YY,V,[1 1],'k','LineWidth',2);

plot(real(z_spec),imag(z_spec),'ko', ...
    'MarkerSize',4,'MarkerFaceColor','k','LineStyle','none');

xlim([real(z0)-rad, real(z0)+rad]);
ylim([imag(z0)-rad, imag(z0)+rad]);

xlabel('Re(z)');
ylabel('Im(z)');
title(plotTitle);

legend('|R(z)| = 1','Scaled spectrum','Location','northeast');

if ~exist(plotDir,'dir')
    mkdir(plotDir);
end

plotFile = fullfile(plotDir, sprintf('pseudocolor_%s_p%d_s%d_chebyshev.png', fileTag, p, s));
